post_install() {
    udevadm control --reload-rules 2>/dev/null
    udevadm trigger --subsystem-match=hidraw --attr-match=idVendor=1532 2>/dev/null
    cat <<MSG
==> Start the Tsuba daemon for your user (and at every login):
      systemctl --user enable --now tsubad
==> Open Tsuba from the application menu. In Settings you can launch it at login (it then
    starts in the tray) and choose notifications. If no device shows up, Home explains why.
==> If openrazer is installed, hand the devices over to Tsuba (reversible):
      tsuba-handover          (undo: tsuba-handover-restore)
MSG
}

post_upgrade() {
    udevadm control --reload-rules 2>/dev/null
    echo "==> Restart the daemon to use the new version: systemctl --user restart tsubad"
}

post_remove() {
    udevadm control --reload-rules 2>/dev/null
    echo "==> Your settings stay in ~/.config/tsuba (see docs/UNINSTALL.md to remove them)."
}
