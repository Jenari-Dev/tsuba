// Version resource. Loaders check that the file version is recent enough before they use the
// library, so the file version is a compatibility number; the product version is Tsuba's.
#include <winver.h>

#ifndef BITS
#define BITS "64"
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION 4,0,0,1
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "JenAriDev"
            VALUE "FileDescription", "Tsuba game lighting bridge (" BITS "-bit)"
            VALUE "FileVersion", "4.0.0.1"
            VALUE "InternalName", "tsuba-game-lighting"
            VALUE "LegalCopyright", "GPL-2.0-or-later. Part of Tsuba, an independent open-source project."
            VALUE "OriginalFilename", "tsuba-game-lighting" BITS ".dll"
            VALUE "ProductName", "Tsuba game lighting bridge"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
