[Desktop Entry]
Type=Application
Name=Tsuba
GenericName=Razer device configuration
GenericName[ja]=Razer デバイスの設定
Comment=Remap keys, set DPI and lighting for Razer keyboards and mice
Comment[ja]=Razer のキーボードとマウスのキー割り当て、DPI、ライティングを設定します
Exec=tsuba-app
Icon=io.github.jenaridev.tsuba
Categories=Settings;HardwareSettings;
Keywords=razer;synapse;keyboard;mouse;dpi;rgb;chroma;macro;
Keywords[ja]=razer;キーボード;マウス;マクロ;ライティング;
StartupWMClass=tsuba-app
X-GNOME-UsesNotifications=true
